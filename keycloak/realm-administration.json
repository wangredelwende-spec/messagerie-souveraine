    {
      "username": "service-account-console",
      "enabled": true,
      "serviceAccountClientId": "console",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "query-groups", "view-realm"]
      }
    }
  ]
}
