# Secrets de la messagerie. Copier ce fichier : cp .env.example .env
# Les valeurs ci-dessous suffisent pour la DÉMO (données fictives).
# En déploiement réel : remplacer CHAQUE valeur, par exemple avec : openssl rand -hex 32
# Le fichier .env n'est jamais commité (voir .gitignore).

# Mot de passe du super-utilisateur PostgreSQL
POSTGRES_PASSWORD=demo-postgres-a-changer

# Mots de passe des deux bases (une par service)
SYNAPSE_DB_PASSWORD=demo-synapse-db-a-changer
KEYCLOAK_DB_PASSWORD=demo-keycloak-db-a-changer

# Administrateur technique de Keycloak (realm « master », console /admin)
KEYCLOAK_ADMIN_PASSWORD=demo-admin-keycloak-a-changer

# Secret partagé entre Keycloak et Synapse (client OIDC « synapse »)
SYNAPSE_OIDC_SECRET=demo-secret-oidc-synapse-a-changer

# Secret partagé entre Keycloak et la console d'administration (client OIDC « console »)
CONSOLE_OIDC_SECRET=demo-secret-oidc-console-a-changer

# Secret de l'API d'enregistrement de Synapse (création du compte de service de la console)
SYNAPSE_REGISTRATION_SECRET=demo-secret-enregistrement-a-changer
